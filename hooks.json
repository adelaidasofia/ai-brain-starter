          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/context-budget-measure.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "Measuring always-loaded context budget..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/surface-connector-liveness.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
