            "statusMessage": "Checking Claude Code version..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/first-week-checkin.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "First-week check-in (day 3 / 7 / 14)..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/migrate-to-user-level.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "Checking for project-level hook migration..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/surface-orphan-claude-branches.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "Checking for orphan claude/* branches..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/surface-stranded-session-artifacts.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "Checking worktrees for stranded session artifacts..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/surface-orphan-worktree-snapshots.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'",
            "statusMessage": "Surfacing recoverable worktree snapshots..."
          },
