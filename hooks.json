            "statusMessage": "Checking for vault-relocation drift (old-path recreators)..."
          },
          {
            "type": "command",
            "command": "[PYTHON] ~/.claude/skills/ai-brain-starter/hooks/dev-hub-refresh-on-session-start.py 2>/dev/null || echo '{\"continue\":true,\"suppressOutput\":true}'"
          },
          {
